{
  "name": "wherever",
  "version": "0.0.0",
  "private": true,
  "description": "Group restaurant picking by swipe. Less group chat, more eating.",
  "license": "MIT",
  "engines": {
    "node": "^22.22.2 || ^24.13.0 || >=26.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev:web": "pnpm --filter @wherever/web dev",
    "dev:worker": "pnpm --filter @wherever/worker dev",
    "deploy": "pnpm run verify && pnpm run deploy:only",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "node --test scripts/*.test.mjs && pnpm -r test",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gates": "node scripts/check-gates.mjs",
    "size": "node scripts/check-size.mjs",
    "comments": "node scripts/check-comments.mjs",
    "css-vars": "node scripts/check-css-vars.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "knip": "knip",
    "dead-classes": "node scripts/dead-classes.mjs",
    "verify": "pnpm run verify:core && pnpm run e2e",
    "deploy:only": "pnpm --filter @wherever/worker run deploy",
    "e2e": "pnpm --filter @wherever/web run e2e",
    "security:check": "pnpm audit --audit-level=low",
    "check:migrations": "pnpm --filter @wherever/worker run check:migrations",
    "deploy:assets": "pnpm --filter @wherever/worker run deploy:assets",
    "verify:core": "pnpm run gates && pnpm run security:check && pnpm run check:migrations && pnpm run size && pnpm run comments && pnpm run css-vars && pnpm run check:docs && pnpm run knip && pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run build && pnpm run dead-classes && pnpm run test"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^8.57.1",
    "knip": "^6.42.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "@esbuild-kit/core-utils>esbuild": "^0.25.12"
    }
  }
}
