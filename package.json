{
  "name": "wherever",
  "version": "0.0.0",
  "private": true,
  "description": "Group restaurant picking by swipe. Less group chat, more eating.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev:web": "pnpm --filter @wherever/web dev",
    "dev:worker": "pnpm --filter @wherever/worker dev",
    "deploy": "pnpm run verify && pnpm run deploy:only",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gates": "node scripts/check-gates.mjs",
    "size": "node scripts/check-size.mjs",
    "comments": "node scripts/check-comments.mjs",
    "css-vars": "node scripts/check-css-vars.mjs",
    "verify": "pnpm run gates && pnpm run size && pnpm run comments && pnpm run css-vars && pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run build && pnpm run test",
    "deploy:only": "pnpm --filter @wherever/worker run deploy"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^8.57.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  }
}
