{
  "name": "@wherever/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "pnpm --filter @wherever/web build && pnpm run deploy:assets",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply wherever --local",
    "check:migrations": "node scripts/check-migrations.mjs",
    "deploy:assets": "wrangler d1 migrations apply wherever --remote && wrangler deploy"
  },
  "dependencies": {
    "@wherever/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.9",
    "@cloudflare/workers-types": "^5.20261028.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.154.0"
  }
}
