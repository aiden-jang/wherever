# Copy to .dev.vars (gitignored) to run the Worker locally.
#
# Sample restaurants need no provider key. A local UsageMeter has its own counters;
# live development consumes provider quota independently of the deployed meter.
# Enable `google` deliberately when checking live data.

RESTAURANT_SOURCE=mock
GOOGLE_PLACES_API_KEY=your-google-places-api-key
# Leave PUBLIC_API_BASE empty in dev: photo-proxy URLs stay relative and Vite proxies /api.
PUBLIC_API_BASE=
